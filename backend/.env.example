GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Fill in your local PostgreSQL credentials (database must already exist)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/speakpractice

WHISPER_MODEL=base

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173
