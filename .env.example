# Backend settings used by docker-compose.yml. Copy this file to .env, then
# set GROQ_API_KEY and adjust DATABASE_URL for your local PostgreSQL instance.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:5432/speakpractice
WHISPER_MODEL=base
CORS_ORIGINS=http://localhost:5173
