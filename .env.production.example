# Public URLs; these are compiled into the frontend image during its build.
VITE_API_BASE_URL=https://api.example.com
VITE_WS_BASE_URL=wss://api.example.com
CORS_ORIGINS=https://app.example.com

# A database reachable from the deployment host/container network.
DATABASE_URL=postgresql+psycopg://user:password@database-host:5432/speakpractice

# Optional host ports when running on a single server.
FRONTEND_PORT=80
BACKEND_PORT=8000
